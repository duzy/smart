project testtrimprefix

p := $/
pat0.0 := **/testdata
pat0.1 := $(p)
pat1.0 := %%/testdata
pat1.1 := $(p)
pat2.0 := /**/testdata
pat2.1 := $(p)
pat3.0 := /%%/testdata
pat3.1 := $(p)

val1 := $(trim-prefix $(dir $/),$/)
val2 := $(trim-prefix  **/testdata/,$/)
val3 := $(trim-prefix  **/testdata/ $(dir2 $/),$/)
val4 := $(trim-prefix  %%/testdata/,$/)
val5 := $(trim-prefix /%%/testdata/,$/)
