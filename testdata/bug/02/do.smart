project testbug

######################## bug origin:

cross.build  := {=no}
cross.target := $(if &(cross.build),$(foreach(-unique) &(--target),--target=$_ -Xclang -triple=$_))

.flag := $(foreach(-unique) \
    $(filter-out $(foreach $1, &($2!$_) &(&(target.os)~$2!$_)), &($2) &(&(target.os)~$2)) \
                 $(foreach $1, &($2.$_) &(&(target.os)~$2.$_)), $(or $3,$2)$_$(or $4))

.flags := &(cross.target) \
    $(foreach(-unique) $1 $2,&(-v.$_)) \
    $(foreach(-unique) $1 $2,$(addprefix -std=,&(-std.$_) &(std.$_))) \
    $(if $(or &(-g) &(&(target.os)~-g) $(foreach $1 $2,&(-g.$_) &(&(target.os)~-g.$_))),-g) \
    $(foreach -g -O -D -f -m -W -I -no -isystem -isystem-after,$(.flag $1 $2,$_,$_)) \
    $(foreach --sysroot -isysroot -iwithsysroot -iframeworkwithsysroot,$(.flag $1 $2,$_,$_=)) \
    $(.flag $1,$(or $3,$2)flags)

flags := $(.flags $1,$2)

######################## bug refactored:

# NOTE: the `&($2.$_)` in 'bug.2' caused a dead-loop-ex bug
bug_0.2 = $(foreach(-unique) $(foreach $1,&($2.$_)),$_)
bug_0.1 = $(foreach x y z,$(bug_0.2 $1 $2,$_,$_))
bug_0   = $(bug_0.1 $1,$2)

bug_1.3 = $(filter-out $(foreach $1,&($2!$_) &(&(target.os)~$2!$_)), &($2) &(&(target.os)~$2))
bug_1.2 = &($2)
bug_1.1 = $(bug_1.2 $1,$(or $3,$2)bug_1)
bug_1   = $(bug_1.1 $1,$2)

######################## bug-free imitations:

okay.2 = $(foreach(-unique) $(foreach $1,$2.$_),$_)
okay.1 = $(foreach x y z,$(okay.2 $1 $2,$_,$_))
okay   = $(okay.1 $1,$2)
