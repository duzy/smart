project testvalcache

files (
    (*.log **.o .deps/??/??/?????????? &(gen)) ⇒ $//.tmp
    (foo/bar.c foo/bar.c++ foo.c foo.c++) ⇒ $//src
)

val0 := **.c
val1 := **.c++
val2 := foo.c++
val3 := foo.o
val4 := .deps/xx/yy/zzzzzzzzzz
val5 := foo/*.c
val6 := foo/*.c++

gen := x.gen y.gen foo/z.gen
nexists1 := $(wildcard(-sort -missing) *.gen)
_exists1 := $(wildcard(-sort)          *.gen)

gen := a.gen b.gen foo/c.gen
nexists2 := $(wildcard(-sort -missing) **.gen)
_exists2 := $(wildcard(-sort)          **.gen)

gen := x.c++ y.c++ foo/z.c
sources := $(wildcard(-sort -missing) **.c **.c++)
objects1 := $(patsubst(-nomap) %.c,%.o,$(sources))
objects2 := $(patsubst(-nomap -filter) %.c++,%.o,$(sources))
