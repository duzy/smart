project testllvmconfig (llvm/Config) #variant=darwin/arm64/bootstrap,

rel.chop =+ $(dir4 $/)/

conf ::= configuration.sm
val1 ::= $(fullname $(conf))
val2 ::= $(file $(conf))

assert (
    $(rel.chop)
    $(rel.remnant)

    $(equal(-d) $(rel.remnant),$(base4 $/))
    $(equal(-d) $(rel.remnant),testdata/modules/llvm/config)
    $(equal(-d) $(fullname llvm/Config/llvm-config.h.cmake), $(srcinc)/llvm/Config/llvm-config.h.cmake)
    $(equal(-d) $(fullname llvm/Config/llvm-config.h),       $(outinc)/llvm/Config/llvm-config.h)

    $(val1)
    $(val2)

    $(src.def.in)
    $(src.h.cmake)

    $(headers)
)

stamp: $(.base) touch
