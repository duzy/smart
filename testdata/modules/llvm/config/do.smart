project testllvmconfig (llvm/Config)

root1  := $/
root2 ::= &/
root3  := &/

chop0 ::= $(rel.chop)
chop1 ::= $(dir4 $/)/

rel.chop =+ $(chop1) # see $(rel.remnant)

remnant0 ::= testdata/modules/llvm/config
remnant1 ::= $(base4 $/)

conf ::= configuration.sm
val1 ::= $(fullname $(conf))
val2 ::=     $(file $(conf))

val3.a ::= $(fullname llvm/Config/llvm-config.h.cmake)
val3.b ::=  $(srcinc)/llvm/Config/llvm-config.h.cmake

val4.a ::= $(fullname llvm/Config/llvm-config.h)
val4.b ::=  $(outinc)/llvm/Config/llvm-config.h

assert (
    $(src.def.in)
    $(src.h.cmake)
    $(headers)
)

stamp: $(.base) touch
