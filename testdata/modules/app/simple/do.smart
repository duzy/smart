project testapp (app/simple)

-f.foo                ::= fooF
-g.foo                ::= fooG
-D.foo                ::= fooD
-O.foo                ::= fooO
-I.foo                ::= fooI
-L.foo                ::= fooL
-l.foo                ::= fool
-Wl.foo               ::= fooWl
-rpath.foo            ::= foorpath
-isystem.foo          ::= fooisystem
-isystem-after.foo    ::= fooisystem-after
-cxx-isystem.foo      ::= foocxxisystem
-stdlib++-isystem.foo ::= foostdlib++isystem
-std.foo              ::= foostd
cflags.foo            ::= cflags-foo
cflags~darwin.foo     ::= cflags~foo~darwin
cxxflags.foo          ::= cxxflags-foo
cxxflags~darwin.foo   ::= cxxflags~foo~darwin
cppflags.foo          ::= cppflags-foo
cppflags~darwin.foo   ::= cppflags~foo~darwin
ldflags.foo           ::= ldflags-foo
ldflags~darwin.foo    ::= ldflags~foo~darwin
ldlibs.foo            ::= ldlibs-foo
ldlibs~darwin.foo     ::= ldlibs~foo~darwin
loadlibes.foo         ::= loadlibes-foo
loadlibes~darwin.foo  ::= loadlibes~foo~darwin
loadlibs.foo          ::= loadlibs-foo
loadlibs~darwin.foo   ::= loadlibs~foo~darwin
fooflags := $(cppflags)
xflags := $(cflags)

.test.foobar: .test.fxxbar ; &(cflags .test.fxxbar)
.test.foobaz: .test.fxxbar ; &(cflags $<)
.test.foobay: .test.fxxbar ; &(cflags $>)
.test.fxxbar:

std.fxxbxx ::= stdfxxbxx1
-std.fxxbxx ::= stdfxxbxx2
-std..test.fxxbar ::= fxxbar

-x := xx yy zz
-x~darwin := sx sy sz
-x~darwin!b := sy
-x~darwin.a := sa
-x!b := yy
-x.a := xa
-x.b := xb
-x.c := xc

.test.1 := ${.test.foobar}
.test.2 := ${.test.foobaz}
.test.3 := ${.test.foobay}
.test.4 := $(fooflags foo)
.test.5 := $(cxxflags foo)
.test.6 := $(ldflags foo)
.test.7 := $(ldlibs foo)
.test.8 := $(loadlibes foo)
.test.9 := $(loadlibs foo)
