project testrules

items := a b c
lines := $(foreach foo bar,{=plainline line-$_})
line = {=plainline foo $1	} bar

-:

rule0:(ARG1 ARG2 ARG3) rule1($@ xyz)
	$< $> - $(ARG1)$(ARG2)$(ARG3)

rule1:(ARG1) {(plain text)}
	$(ARG1)

foreach x y z
{=word rule-$_}:(ARGS){(plain text)}
	$(foreach $(ARGS),arg-$_)
done

foreach xx yy zz
{=word rule-$_}:(ARGS){(plain text)}
	$(foreach $(ARGS),{=plainline arg-$_})
done

foreach xxx yyy zzz
{=word rule-$_}:{(plain text)}
	{=foreach $(items),arg-$_}
done
