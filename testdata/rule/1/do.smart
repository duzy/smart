project testrules

-:

.test.foobax: .test.fxx ; &(foo fxxbar)
.test.foobay: .test.fxx ; &(foo $<)
.test.foobaz: .test.fxx ; &(foo $>)
.test.fxx: ; 'fxx'

'.test.foo':

v1 := '.test.foo'

c = 0
foo = $1$(debug $1 $@ $< $^ $>)

.test.1 := ${.test.foobax}
.test.2 := ${.test.foobay}
.test.3 := ${.test.foobaz}

fxx := $(debug ${.test.fxx})
