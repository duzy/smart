project testrules

-:

.test.0:((str line))
	$(debug $(line) $(str))

.test.01 := ${.test.0 a,b}
.test.02  = ${.test.0 a,b}

.test:((str line)) {(eval)}
	$(debug $(line) $(str))

.test.v1 := ${.test a,b}
.test.v2  = ${.test a,b}
.test.v3  = ${.test $1,$2}
.test.v4 := $(.test.v3 a,b)

.test1: {(shell -for-stdout=${.test $1,$2})}
	echo "test one"
	echo "test two"

.test2: {(shell -for-stderr=${.test $1,$2})}
	echo "test one" > /dev/stderr
	echo "test two" > /dev/stderr
