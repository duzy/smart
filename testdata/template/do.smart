project testtemplate

types ::= xxx yyy zzz

foreach $(types)
var.$_ ::= test-$_
done

.test.1 :=
.test.2 :=
.test.3 :=

for type=$(types)
.test.1 += $(type)
done

foreach $(defs(-rn=1 -r='^var\.([xyz]+)$'))
.test.2 += $_
done

def foo(x)
.test.3 += $(x)
end

for type=$(types) #template for type=$(types)
.test.1 += $(type)
done #template expand

foreach $(defs(-rn=1 -r='^var\.([xyz]+)$')) #template foreach $(defs(-rn=1 -r='^var\.([xyz]+)$'))
.test.2 += $_
done #template expand

def bar(x) #template def bar(x)
.test.3 += $(x)
end #template end

foo(xxx) #template foo(xxx)
foo(yyy) #template foo(yyy)
foo(zzz) #template foo(zzz)
bar(xxx) #template bar(xxx)
bar(yyy) #template bar(yyy)
bar(zzz) #template bar(zzz)
