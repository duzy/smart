project testforeach

.test.1 := x
.test.1 += $(foreach $1,&(.test.h)$_)
.test.h := -
# assert $(.test.1 a b c) $(equal(-d) $(.test.1 x y z),x -x -y -z)

.test.2 := x
.test.2 += $(foreach q p $(foreach $1,&(.test.h)$_),x$_)
# assert $(.test.2 a b c) $(equal(-d) $(.test.2 x y z),x xq xp x-x x-y x-z)

.test.21 ::= x
.test.21 += $(foreach q p $(foreach $1,&(.test.h)$_),x$_)
# assert $(.test.21 a b c) $(equal(-d) $(.test.21 x y z),x xq xp)

.test.22 ::= x
.test.22 += $(foreach &(.test.h) $(foreach $1,&(.test.h)$_),x$_)

.test.3 := x
.test.3 += $(foreach $1,&(.test.$_)$1) y
.test.3 += $(foreach $1,$(value(-c) .test.$_)$1) z
# assert $(.test.3 foo) $(equal(-d) $(.test.3 foo),x -foo -foo y)

.test.4   := $(foreach $1 $2,&(.test.$_.$(or $4,$3)))
.test.x.a := xa
.test.x.b := xb
.test.y.a := ya
.test.y.b := yb
# assert $(equal(-d) $(.test.4 x,y,a,b),xb yb)
# assert $(equal(-d) $(.test.4 x,y, ,b),xb yb)
# assert $(equal(-d) $(.test.4 x,y,a  ),xa ya)

.test.5 := $(foreach do.smart,&(.test.x $_))
.test.x := $(stat(-f) $//$1)
# assert $(foreach do.smart,$(.test.x $_))
