project testforeach4

.test.1 := $(foreach $(foreach $1 $2,x$_),X$_)
.test.2 := $(foreach $(foreach $1 $2,&(.test.x$_)),X$_)
.test.3 := $(foreach $(foreach $(foreach $1 $2,&(.test.x$_)),X$_),Y$_)

.test.x  := $(foreach $(foreach $1 $2,        x$_) ,X$_) \
            $(foreach $(foreach $1 $2,&(.test.x$_)),X$_)
.test.y  := y
.test.y  += $(.test.x $1,b)
.test.z  := z $(.test.y)
.test.xa := ~1~ $1 $2 $(foreach $1 $2,x-$_) $(foreach $(foreach $1 $2,x-$_),~1~$_)
.test.xb := ~2~ $1 $2 $(foreach $1 $2,x-$_) $(foreach $(foreach $1 $2,x-$_),~2~$_)
.test.xb += $(foreach $(foreach $(foreach $(foreach $1 $2,~$_),~$_),~$_),~$_)
.test.a  := $(.test.xa $1,b)
.test.b  := $(.test.xb $1,b)
.test.c  := $(.test.z)
