project testbuiltins

p := $/

pat0 :=  **/testdata
pat1 :=  %%/testdata
pat2 := /**/testdata
pat3 := /%%/testdata

val1 := $(trim-prefix          $(dir  $/),$/)
val2 := $(trim-prefix $(pat0)/ $(dir2 $/),$/) # NOTE: $(pat0)/ has no effect, $(dir2 $/) is `/…/testdata`
val3 := $(trim-prefix $(pat0)/,$/)
val4 := $(trim-prefix $(pat1)/,$/)
val5 := $(trim-prefix $(pat2)/,$/)
val6 := $(trim-prefix $(pat3)/,$/)

pat4 :=  *?/testdata
pat5 := /*?/testdata

val7 := $(trim-prefix $(pat4)/,$/)
val8 := $(trim-prefix $(pat5)/,$/)
val9 := $(trim-prefix /*?/testdata/,$/)

val10 := $(trim-prefix /**/testdata /builtins,$/)
val11 := $(trim-prefix /**/testdata/ builtins,$/)
val12 := $(trim-prefix /**/ trimprefix,$/)
val13 := $(trim-prefix /**/ trimprefix/,$//)
val14 := $(trim-prefix  **/testdata/**,$/)
val15 := $(trim-prefix  **/testdata/**/,$//)
val16 := $(trim-prefix /**/testdata/**,$/)
val17 := $(trim-prefix /**/testdata/**/,$//)

val18 := $(trim-prefix  *?/testdata/*?,$/)
val19 := $(trim-prefix  *?/testdata/*?/,$//)
val20 := $(trim-prefix /*?/testdata/*?,$/)
val21 := $(trim-prefix /*?/testdata/*?/,$//)
val22 := $(trim-prefix          /*?/,$//)
val23 := $(trim-prefix /*?/test*/*?/,$//)
val24 := $(trim-prefix /*?/test*/**/,$//)
val25 := $(trim-prefix /*?/*data/*?/,$//)
val26 := $(trim-prefix /**/*data/*?/,$//)
val27 := $(trim-prefix /*?/t*a/*?/,$//)
