project testbuiltins

val1 = $(addprefix -std=,foo)
val2 = $(addprefix -std=,foo bar)
val3 = $(addprefix -foo=,bar &(none))
val4 = $(addprefix std=,&(.test.$1))
val5 = $(addprefix foo,bar &(none))
val6 = $(addprefix foo bar,=xxx)
val7 = $(addprefix foo &(.test.$1),=xxx)
val8 = $(addprefix foo &(.test.$1),=&(.test.$1))
val9 = $(addprefix fo-,&(.test.$1.x.$2.y.$3.z))

.test.{} = test
.test.  += null
.test.a := ax ay az
.test.b := bx by bz
.test.c := cx cy cz
.test.a.x.1.y.0.z := ax ay az
.test.b.x.1.y.0.z := bx by bz
.test.b.x.2.y.0.z := cx cy cz
.test.c.x.1.y.0.z := dx dy dz
.test.c.x.2.y.0.z := ex ey ez
.test.c.x.3.y.0.z := fx fy fz
.test.⌜a b⌟ := ax ay bx by
.test.⌜a b c⌟.x.⌜1 2 3⌟.y.0.z := a1 b2 c3

val41 = $(addprefix std=,&(.test.{$1}))
val81 = $(addprefix foo &(.test.{$1}),=&(.test.{$1}))
val91 = $(addprefix fo-,&(.test.{$1}.x.{$2}.y.{$3}.z))
