project testbuiltins

files (
    (foo/bar/zz/x.h foo/bar/v?.h foo/*.h foo/**.hh foo???/x.h) ⇒ $(dir $/)/inc
)

val1 ::= $(wildcard(-sort)  *.h)
val2 ::= $(wildcard(-sort) **.h)
val3 ::= $(wildcard(-sort) foo/*.h)
val4 ::= $(wildcard(-sort) foo/bar/*.h)
val5 ::= $(wildcard(-sort) foo/bar/*/*.h)
val6 ::= $(wildcard(-sort) foo/bar/z?/?.h)
val7 ::= $(wildcard(-sort) foo/bar/zz/?.h)
val9 ::= $(wildcard(-sort) foo/bar/v1.h foo/bar/v2.h)
va10 ::= $(wildcard(-sort) foo/bar/*.hh)
