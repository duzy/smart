project testbuiltins

files (
    (foo/bar/zz/x.h **.h **.def.am) ⇒ $//inc
)

top := $/
inc := $//inc

pat1 ::=  *.h
pat2 ::= **.h
pat3 ::= foobar/config/*.def.am
pat4 ::= foobar/config/*.def.in
pat5 ::=  *.def.am
pat6 ::= **.def.am

val1 ::= $(wildcard(-sort -dir=$/) inc/*.h inc/*/*.h inc/*/*/*.h)
val2 ::= $(wildcard(-sort -dir=$/) inc/**.h)
val3 ::= $(wildcard(-sort -dir=$//inc) **.h)
val4 ::= $(wildcard(-sort) **.h)
val5 ::= $(wildcard(-sort)  *.h)

# NOTE: the files maps have no explicit entry for "foobar/config/…"
fix1 ::= $(wildcard(-sort)             foobar/config/*.def.am)
fix2 ::= $(wildcard(-sort)             foobar/config/*.def.in)
fix3 ::= $(wildcard(-sort -dir=$//inc) foobar/config/*.def.am)
fix4 ::= $(wildcard(-sort -dir=$//inc) foobar/config/*.def.in)

