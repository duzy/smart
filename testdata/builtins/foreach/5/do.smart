project testbuiltins

.test.x.x    = $(foreach $1 $2,&(.test.x.$_)       &(.test.x.&(.test.o).$_))
.test.x.y    = $(foreach $1 $2,&(.test.x.$_ $1,$2) &(.test.x.&(.test.o).$_))
.test.x.0    = $(.test.x.x)
.test.x.1    = $(.test.x.x $1)
.test.x.2    = $(.test.x.x $1,$2)
.test.x.3   := $(.test.x.x)
.test.x.4   := $(.test.x.x $1)
.test.x.5   := $(.test.x.x $1,$2)
.test.x.6    = $(.test.x.y $1)
.test.x.7    = $(.test.x.y   ,$2)
.test.x.8    = $(.test.x.y $1,$2)
.test.x.10  := $(.test.x.y a)
.test.x.11  := $(.test.x.y  ,b)
.test.x.12  := $(.test.x.y a,b)
.test.x.a    = a~ $(foreach $(foreach $1 $2,$(.test.x.o.$_)),-ao$_) ~a
.test.x.b    = b~ $(foreach $(foreach $1 $2,&(.test.x.o.$_)),-bo$_) ~b
.test.x.c   := ~c~
.test.x.o.a := x.o.a
.test.x.o.b := x.o.b
.test.x.o.c := x.o.c
.test.o     := o
