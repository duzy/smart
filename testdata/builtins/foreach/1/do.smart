project testbuiltins

.test.x = &(.test.s) $(value .test~&(.test.s)) \
    $(foreach $1 $2, $(closure .test.$_) $(closure .test~&(.test.s).$_))

.test.1 = $(.test.x $1,B b)

.test.s     := foo

.test.A     := test-A
.test.a     := test-a
.test.B     := test-B
.test.b     := test-b
.test~foo   := test-foo
.test~foo.A := test-foo-A
.test~foo.a := test-foo-a
.test~foo.B := test-foo-B
.test~foo.b := test-foo-b
