project testbuiltins

.test.foreach.a = $(foreach $1 $(foreach $2,a$_),b$_)
.test.foreach.b = $(.test.foreach.a x$1 y$1 z$1,xx$2 yy$2)
.test.foreach.c = $(.test.foreach.b) \
    $(foreach &(.test.foreach.x) $(foreach $1 $2,$(closure .test.foreach.x.$_)),-x$_)


.test.1 = $(.test.foreach.b)


.test.2 = $(.test.foreach.c)
.test.foreach.x.1 = X$1$2
.test.foreach.x.2 = Y$1$2
.test.foreach.x ::= xy # this does not take effect


.test.3 = $(.test.foreach.c $1,4)
.test.foreach.x.3 = V$1$2
.test.foreach.x.4 = W$1$2
.test.foreach.x ::= vw


.test.foreach.d   = $(foreach $1 $2,$(.test.foreach.d.$_ $3,$4))
.test.foreach.d.1 = $(foreach $1 $2,-x$_)
.test.foreach.d.2 = $(foreach $1 $2,-y$_)
.test.4 = $(.test.foreach.d)
