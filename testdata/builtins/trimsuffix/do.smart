project testbuiltins

d := $(dir3 $/)
p := $/

pat0 := testdata/**
pat1 := testdata/%%
pat2 := testdata/**/
pat3 := testdata/%%/

val1 := $(trim-suffix          $(base3 $/),$/)
val2 := $(trim-suffix  $(pat0) $(base2 $/),$/)
val3 := $(trim-suffix  $(pat0),$/)
val4 := $(trim-suffix /$(pat1),$/)
val5 := $(trim-suffix /$(pat2),$//)
val6 := $(trim-suffix /$(pat3),$//)
