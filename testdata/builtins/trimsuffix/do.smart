project testbuiltins

d := $(dir3 $/)
p := $/

pat0 := testdata/**
pat1 := testdata/%%
pat2 := testdata/**/
pat3 := testdata/%%/

val1 := $(trim-suffix          $(base3 $/),$/)
val2 := $(trim-suffix  $(pat0) $(base2 $/),$/)
val3 := $(trim-suffix  $(pat0),$/)
val4 := $(trim-suffix /$(pat1),$/)
val5 := $(trim-suffix /$(pat2),$//)
val6 := $(trim-suffix /$(pat3),$//)

val7  := $(trim-suffix  **/testdata/**,$/)
val8  := $(trim-suffix  **/testdata/**/,$//)
val9  := $(trim-suffix /**/testdata/**,$/)
val10 := $(trim-suffix /**/testdata/**/,$//)
val11 := $(trim-suffix     testdata/**,$/)
val12 := $(trim-suffix    /testdata/**,$/)
val13 := $(trim-suffix     testdata/**/,$//)
val14 := $(trim-suffix    /testdata/**/,$//)
val15 := $(trim-suffix             /**/,$//)

val16 := $(trim-suffix  *?/testdata/*?,$/)
val17 := $(trim-suffix  *?/testdata/*?/,$//)
val18 := $(trim-suffix /*?/testdata/*?,$/)
val19 := $(trim-suffix /*?/testdata/*?/,$//)
val20 := $(trim-suffix          /*?/,$//)
val21 := $(trim-suffix /*?/test*/*?/,$//)
val22 := $(trim-suffix /*?/test*/**/,$//)
val23 := $(trim-suffix /*?/*data/*?/,$//)
val24 := $(trim-suffix /**/*data/*?/,$//)
val25 := $(trim-suffix /*?/t*a/*?/,$//)
