project testvalue

vals = {word foo/bar 'strlit' "strcomp" {=int 0} {=int 1}} \
    {=answer yes} {=bool false} {=boolean true} \
    {=path foo} {=path 'foo/bar'} {=file foobar} {=glob **.c} {=regex xx} \
    {=int 1} {=float .1} {=none anything goes} {=null} \

cond0   = x?
cond01  = x?y
cond02  = x???y
cond03  = x&(something)?y
cond1  := x?    # → x
cond11 := x?y   # → xy
cond12 := x???y # → xy
cond13 := x&(something)?y # → x&(something)y?

disjunction0   = {a b c}
disjunction00  = x{}
disjunction01  = x{$1}
disjunction02  = x{&(something)}
disjunction03  = x{a b c}
disjunction1  := x{a b c}y{1 2 3}z
disjunction2 ::= x{a b c}y{1 2 3}z

glob1 = {=glob    *.c}
glob2 = {=glob   **.c}
glob3 = {=glob x*z?.c}

regex1 ::= {=regex x{1}, x{1,}, x{1,2}, x{5}?, x{2,}?, x{2,8}? \p{Greek}, \P{Greek}}
regex2 ::= {=regex (re) (?P<name>re) (?:re) (?im) (?sU:re) \x{10ffff} \x1f \123 \* \. \? \$}
regex3 ::= {=regex [[:xdigit:]]*, [^[:alpha:]], [^xyz] [a-z] \A \B \b \Q**??^:[]{}\E \^ \z}
regex4 ::= {=regex fo{2}\.c}
regex5 ::= {=regex fo{2}/bar\.c}
regex6 ::= {=regex fo{2}(/o{2}){3}/bar\.c}

modifiers := {(assert {=no}) (plain cxx)}

val1   = foo.c
val2   = foo/bar.c
val3   = foo/oo/oo/oo/bar.c
val4  :=         a\,b\,c,x\,y\,z
val5  := $(quote a\,b\,c,x\,y\,z) #{=quote $(val4),123}
val6  := http://extbit.io/help
val7  := https://extbit.com
val8  := https://extbit.com?foo=x
val9  := https://extbit.com?foo=x&bar=y#foobar
val10 := https://ext.pub?foo=x+y+z&bar=x%20y%20z#foo+bar

configure.types."atomic.h" ::= atomic_bool
configure.types.<atomic.h> ::= atomic_bool
foreach {=defs {=regex ^configure\.types\.(<(.+?)>|"(.+?)")}}
configure.types += - $0 $1 $2, $3.
done

configure conf0 = $@
configure conf1 = $(grep {=regex ^.+?\.o$$},$0,$//test.txt)
configure conf2 = $(grep {=regex ^(.+?)((-(?P<i>.+?))*)(\.)(?P<x>o)$$},$0 $1 $2 $3 $(i) $5 $(x),$//test.txt)
#configure conf = {=grep {=regex ^(.+?)((-(?P<i>.+?))*)(\.)(?P<x>o)$$},$0 $1 $2 $3 $(i) $5 $(x),$//test.txt}
configure conf3 : foo bar ; $@, $< $>, $^

foo:
bar:
