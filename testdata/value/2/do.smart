project testvalue

# TEST: delegate calling parameters to value of closure, $(value(-clo) &(.text-x))

.test.ab   = foobar $1-$2
.test.ba   = foobaz $2-$1
.test     := x $(closure &(.test.x))
.test     += y $(&(.test.x) $1$1,$2$2)

.test.0  ::= $(.test) $3
.test.s1 ::= $(string  $(.test.0))
.test.s2 ::= $(finalize $(.test.0))
.test.s3  := $(string a b c)

.test.1   := $(.test) $3

.test.x   := .test.ba
.test.2  ::= $(.test) $3
.test.3   := $(.test) $3

.test     += z $(call(-closure) &(.test.x),$1$2,$2$1)
.test     += Z $3
.test.x   := .test.ab
.test.4  ::= $(.test) . $3
.test.5   := $(.test) . $3
