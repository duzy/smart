project testvalue

# TEST: delegate calling parameters to value of closure, $(value(-closure) &(.text-x))

.test.ab   = foo_ab-$1-$2
.test.ba   = foo_ba-$2-$1

.test.0    = 1 $(closure &(.test.x)) 10
.test.1   := 1 $(closure &(.test.x)) 11
.test.2  ::= 1 $(closure &(.test.x)) 12
.test.0   += 2 $(&(.test.x) $1$1,$2$2) 20
.test.1   += 2 $(&(.test.x) $1$1,$2$2) 21
.test.2   += 2 $(&(.test.x) $1$1,$2$2) 22

.test.s0 ::= $(.test.1) $3 s0
.test.s1 ::= $(finalize $(.test.s0)) s1
.test.s2 ::= {=str $(.test.s0)}
.test.s3  := {=str a b c}

.test.t1  := $(.test.0) $3
.test.x   :=   .test.ba
.test.t2  := $(.test.0) $3
.test.t3 ::= $(.test.0) $3

.test.0   += 3 $(call &(.test.x),$1$2,$2$1) $(call(-closure) &(.test.x),$1$2,$2$1)
.test.1   += 3 $(call &(.test.x),$1$2,$2$1) $(call(-closure) &(.test.x),$1$2,$2$1)
.test.2   += 3 $(call &(.test.x),$1$2,$2$1) $(call(-closure) &(.test.x),$1$2,$2$1)
.test.0   += 4 $3
.test.1   += 4 $3
.test.2   += 4 $3

.test.x   :=   .test.ab
.test.t4   = $(.test.0) . $3
.test.t5  := $(.test.0) . $3
.test.t6 ::= $(.test.0) . $3
