project testvalue

.test.ab = foo_ab-$1-$2
.test.ba = foo_ba-$2-$1

.test     = 1 $1$2$3 10
.test.1  := $(.test a,b,c)
.test.2 ::= $(.test a,b,c)

.test    += 2 $(&(.test.x) $1$1,$2$2) 20
.test.3  := $(.test a,b,c)
.test.4 ::= $(.test a,b,c)

# .test.s0 ::= $(.test x,y) $3 s0
# .test.s1 ::= $(.test.s0) s1

.test.t1  := $(.test x,y) $3
.test.x   :=   .test.ba
.test.t2  := $(.test x,y) $3
.test.t3 ::= $(.test x,y) $3

.test    += 3 &(&(.test.x) $1$2,$2$1) 30
.test.5  := $(.test a,b,c)
.test.6 ::= $(.test a,b,c)

.test    += 4 $3 40

.test.x   :=   .test.ab
.test.t4   = $(.test x,y) . $3
.test.t5  := $(.test x,y) . $3
.test.t6 ::= $(.test x,y) . $3
