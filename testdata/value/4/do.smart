project testvalue

.test.* :=

for flag=(D I)
 for lang=(c c++)
 .test.* += $(flag).$(lang)(-unique)
 .test.$(flag).$(lang) := $(flag) $(lang)
 done
done

for a=(x y) and n=(1 2)
.test.and.$(a).$(n) = $(a)$(n)
done

.test.D.c += $(value &(.test.x))
.test.D.c += $(value   .test.v)

.test.v := xx
.test.x := .test.v

.test.D.c += &(value $(.test.x))

.test.I.c += &(value &(.test.x))
.test.I.c += &(value $(.test.x))
.test.I.c += $(value &(.test.x))
.test.I.c += $(value $(.test.x))

.test.foreach = ($1)

.test.D.c += $(.test.foreach $1,&(.test.none)) ($1)
.test.D.c += $(foreach $1,&(.test.x.$_)) ($1)

.test.x.a := x
.test.x.b := y
.test.x.c := z
